# Public insurance API testing sandbox: https://www.insuresandbox.com
# For CI, prefer a staging environment you control and are authorized to test.
BASE_URL=https://www.insuresandbox.com

# Set true after adapting the quote CTA label and expected staging flow.
RUN_QUOTE_FLOW=false
QUOTE_CTA_NAME=Get a quote

# Playwright adds this delay to clicks for deliberate, stable UI interaction.
PACED_CLICK_DELAY_MS=100